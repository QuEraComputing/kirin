#[automatically_derived]
impl kirin_chumsky::ParseDispatch for MixedStage {
    fn dispatch_first_pass(
        &mut self,
        stage_id: kirin_ir::CompileStage,
        ctx: &mut kirin_chumsky::FirstPassCtx<'_>,
    ) -> ::core::result::Result<
        ::core::option::Option<kirin_chumsky::FirstPassDispatchResult>,
        kirin_chumsky::FunctionParseError,
    > {
        match self {
            MixedStage::StageA(stage_info) => {
                kirin_chumsky::first_pass_concrete::<FunctionDefinition>(stage_info, stage_id, ctx)
                    .map(::core::option::Option::Some)
            }
            MixedStage::StageB(stage_info) => {
                kirin_chumsky::first_pass_concrete::<LowerDefinition>(stage_info, stage_id, ctx)
                    .map(::core::option::Option::Some)
            }
        }
    }
    fn dispatch_second_pass(
        &mut self,
        stage_id: kirin_ir::CompileStage,
        ctx: &mut kirin_chumsky::SecondPassCtx<'_>,
    ) -> ::core::result::Result<::core::option::Option<usize>, kirin_chumsky::FunctionParseError>
    {
        match self {
            MixedStage::StageA(stage_info) => {
                kirin_chumsky::second_pass_concrete::<FunctionDefinition>(stage_info, stage_id, ctx)
                    .map(::core::option::Option::Some)
            }
            MixedStage::StageB(stage_info) => {
                kirin_chumsky::second_pass_concrete::<LowerDefinition>(stage_info, stage_id, ctx)
                    .map(::core::option::Option::Some)
            }
        }
    }
    fn dispatch_module(
        &mut self,
        input: &str,
    ) -> ::core::result::Result<
        ::core::option::Option<kirin_chumsky::PendingModule>,
        kirin_chumsky::ChumskyError,
    > {
        match self {
            MixedStage::StageA(stage_info) => {
                kirin_chumsky::PendingModule::emit::<FunctionDefinition>(stage_info, input)
                    .map(::core::option::Option::Some)
            }
            MixedStage::StageB(stage_info) => {
                kirin_chumsky::PendingModule::emit::<LowerDefinition>(stage_info, input)
                    .map(::core::option::Option::Some)
            }
        }
    }
    fn dispatch_attach_module(
        &mut self,
        pending: kirin_chumsky::PendingModule,
    ) -> kirin_ir::Module {
        match self {
            MixedStage::StageA(stage_info) => pending.attach(stage_info),
            MixedStage::StageB(stage_info) => pending.attach(stage_info),
        }
    }
}
